{
  "name": "filmidi-editor",
  "version": "0.0.1",
  "description": "Filmidi video editor powered by Electrobun and VideoFlow",
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/cpatra11/filmidi-2.git"
  },
  "homepage": "https://github.com/cpatra11/filmidi-2",
  "scripts": {
    "postinstall": "bun run patches/patch-dom-renderer.ts && bun run patches/patch-video-editor.ts && bun run patches/patch-video-layer.ts && bun run patches/patch-track-normalization.ts",
    "build:sidecar": "bash scripts/build-sidecar.sh",
    "start": "bun run build:sidecar && vite build && electrobun dev",
    "dev": "bun run build:sidecar && electrobun dev --watch",
    "dev:hmr": "concurrently \"bun run hmr\" \"bun run start\"",
    "hmr": "vite --port 5173",
    "build": "bun run build:sidecar && vite build && electrobun build --env=canary",
    "build:prod": "bun run build:sidecar && vite build && electrobun build --env=production",
    "test": "bun test"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.14",
    "@assistant-ui/react": "^0.14.26",
    "@assistant-ui/react-ai-sdk": "^1.3.40",
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@radix-ui/react-collapsible": "^1.1.16",
    "@radix-ui/react-context-menu": "^2.3.3",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-popover": "^1.1.19",
    "@radix-ui/react-radio-group": "^1.4.3",
    "@radix-ui/react-select": "^2.3.3",
    "@radix-ui/react-slider": "^1.4.3",
    "@radix-ui/react-switch": "^1.3.3",
    "@radix-ui/react-tabs": "^1.1.17",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@shiguredo/rnnoise-wasm": "^2025.1.5",
    "@tanstack/react-query": "^5.101.2",
    "@videoflow/core": "1.2.2",
    "@videoflow/react-video-editor": "1.2.2",
    "@videoflow/renderer-browser": "1.2.2",
    "@videoflow/renderer-dom": "1.2.2",
    "@videoflow/renderer-server": "1.2.2",
    "ai": "^7.0.26",
    "chromium-bidi": "0.6.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "electrobun": "1.18.4-beta.6",
    "fflate": "^0.8.3",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.24.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^4.12.2",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.185.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "concurrently": "^9.1.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.16",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
